    {
      "cell_type": "code",
      "source": [
        "# 為了方便您執行公式，我們將 df 指向含有原始交易紀錄的 df_raw\n",
        "# 並將您公式中的欄位對應至原始欄位：\n",
        "# CustomerID -> 客戶ID\n",
        "# InvoiceDate -> date\n",
        "# InvoiceNo -> 發票編號\n",
        "# Amount -> 金額\n",
        "\n",
        "df = df_raw.copy()\n",
        "\n",
        "# 1. 確保日期欄位是 datetime 格式\n",
        "df['date'] = pd.to_datetime(df['date'])\n",
        "\n",
        "# 2. 取得最新日期作為基準日\n",
        "snapshot_date = df['date'].max()\n",
        "\n",
        "# 3. 進行 Groupby 聚合計算\n",
        "rfm = df.groupby('客戶ID').agg(\n",
        "    F=('發票編號', 'count'),\n",
        "    M=('金額', 'sum'),\n",
        "    max_date=('date', 'max')\n",
        ").reset_index()\n",
        "\n",
        "# 4. 計算 R (天數)\n",
        "rfm['R'] = (snapshot_date - rfm['max_date']).dt.days\n",
        "\n",
        "# 5. 重新命名客戶 ID 欄位並調整欄位順序\n",
        "rfm = rfm.rename(columns={\n",
        "    '客戶ID': 'Customer'\n",
        "})\n",
        "\n",
        "rfm = rfm[['Customer', 'R', 'F', 'M']]\n",
        "\n",
        "# 顯示最終結果\n",
        "display(rfm)"
      ],
